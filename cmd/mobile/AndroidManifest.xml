<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom Android manifest — required for BACKGROUND AUDIO, which needs a
  <service android:foregroundServiceType="mediaPlayback"> that Fyne's generated
  manifest can't declare. Fyne (fyne-io/tools v1.7.2) uses this file VERBATIM
  when it sits next to main.go, so it must carry everything the app needs; it
  replicates fyne's own template (templates/data/AndroidManifest.xml) exactly,
  plus the BtAudioService block. Ground rules, all source-verified:

  - The presence of Icon-foreground.png (same dir) flips fyne onto its aapt2
    resource path — REQUIRED: the legacy binres encoder can't encode the
    android:foregroundServiceType attribute (API 29 attr vs its baked-in API 21
    table) and would fail the build on this file.
  - Do NOT add android:versionCode / android:versionName or <uses-sdk> here:
    fyne passes them as aapt2 link flags (-app-build / -app-version, min 21,
    target 35 release / 29 debug), and flag values only apply when the manifest
    doesn't already declare them — hardcoding here would freeze the versionCode.
  - The activity MUST stay org.golang.app.GoNativeActivity with the
    android.app.lib_name meta-data (value = fyne's sanitized app name,
    "BibleText" → libBibleText.so) — fyne parses + validates both.
  - android:icon must be @mipmap/ic_launcher (the adaptive icon fyne compiles
    from Icon-foreground.png / Icon-background.png on the aapt2 path).
  - android:launchMode="singleTop" is ours (fyne's template omits it): a shared
    link tapped while the app is already running must be delivered to the
    EXISTING activity, because the default "standard" mode would create a
    SECOND NativeActivity instance over the one Go runtime.
-->
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	package="uk.co.bibletext">

	<application android:label="BibleText"
				 android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
	<activity android:name="org.golang.app.GoNativeActivity"
		android:label="BibleText"
		android:configChanges="orientation|keyboardHidden|uiMode"
		android:exported="true"
		android:launchMode="singleTop"
		android:theme="@android:style/Theme">
		<meta-data android:name="android.app.lib_name" android:value="BibleText" />
		<intent-filter>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent-filter>
		<!-- App Links: a shared bibletext.co.uk verse link opens the app.
		     android:autoVerify makes Android check
		     https://bibletext.co.uk/.well-known/assetlinks.json against this
		     app's signing certificate at install time; unverified links are
		     NOT claimed on Android 12+, so a mismatch degrades to the web page
		     rather than to a broken app — which is the behaviour we want.

		     The pathPrefixes are an ALLOW-LIST for the same reason the Apple
		     association file is: /privacy.html and /support.html are the URLs
		     registered with App Store Connect (and linked from the app), and
		     they must always open in the browser. Never widen this to the bare
		     host. -->
		<intent-filter android:autoVerify="true">
			<action android:name="android.intent.action.VIEW" />
			<category android:name="android.intent.category.DEFAULT" />
			<category android:name="android.intent.category.BROWSABLE" />
			<data android:scheme="https" android:host="bibletext.co.uk" android:pathPrefix="/web/" />
			<data android:scheme="https" android:host="bibletext.co.uk" android:pathPrefix="/bsb/" />
			<data android:scheme="https" android:host="bibletext.co.uk" android:pathPrefix="/webc/" />
		</intent-filter>
	</activity>

	<receiver android:name="org.golang.app.FyneNotificationReceiver"
			  android:exported="false" />

	<!-- Background audio: the foreground-service anchor (android/BtAudioService.java,
	     shipped in classes2.dex) that keeps narration alive with the screen off and
	     hosts the MediaStyle notification / lock-screen transport. -->
	<service android:name="org.bibletext.BtAudioService"
		android:exported="false"
		android:foregroundServiceType="mediaPlayback" />
	</application>

	<!-- Package visibility (Android 11+): without this the app cannot SEE a
	     browser to resolve, so handing a shared link back out — which is what
	     happens when a note arrives with notes switched off — would silently do
	     nothing. Declares only "something that opens https", nothing broader. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<category android:name="android.intent.category.BROWSABLE" />
			<data android:scheme="https" />
		</intent>
	</queries>

	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Background audio (Phase 2) -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
