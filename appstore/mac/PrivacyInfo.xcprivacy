<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>
  <!-- Reading history, notes and saved provider keys stay on device.
       Optional AI requests go directly to the provider selected by the reader,
       under the reader's own key. The developer does not receive these requests.
       Provider retention and use depend on the reader's provider account. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <!-- Required-reason API declarations apply to the mobile Apple platforms. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array/>
</dict>
</plist>
