diff -ruN ft-pristine/cmd/fyne/internal/commands/package_unix_bibletext_source_test.go ft-patched/cmd/fyne/internal/commands/package_unix_bibletext_source_test.go
--- a/cmd/fyne/internal/commands/package_unix_bibletext_source_test.go
+++ b/cmd/fyne/internal/commands/package_unix_bibletext_source_test.go
@@ -0,0 +1,15 @@
+package commands
+
+import (
+	"os"
+	"testing"
+)
+
+func readPackageUnixSource(t *testing.T) string {
+	t.Helper()
+	b, err := os.ReadFile("package-unix.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
diff -ruN ft-pristine/cmd/fyne/internal/commands/package_unix_bibletext_test.go ft-patched/cmd/fyne/internal/commands/package_unix_bibletext_test.go
--- a/cmd/fyne/internal/commands/package_unix_bibletext_test.go
+++ b/cmd/fyne/internal/commands/package_unix_bibletext_test.go
@@ -0,0 +1,103 @@
+package commands
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"fyne.io/tools/cmd/fyne/internal/templates"
+)
+
+// A desktop entry that registers a URL scheme must be launched with the URL
+// (%u), the Makefile must keep the bare binary name, and the installed entry
+// must reach mimeinfo.cache, or no browser ever finds the handler.
+func TestSchemeHandlerEntryUsesTheURLFieldCode(t *testing.T) {
+	render := func(data unixData) (entry, makefile string) {
+		var e, m bytes.Buffer
+		if err := templates.DesktopFileUNIX.Execute(&e, data); err != nil {
+			t.Fatal(err)
+		}
+		if err := templates.MakefileUNIX.Execute(&m, data); err != nil {
+			t.Fatal(err)
+		}
+		return e.String(), m.String()
+	}
+	scheme := unixData{Name: "BibleText", AppID: "uk.co.bibletext", Exec: "bibletext", ExecField: " %u",
+		Icon: "uk.co.bibletext", MimeTypes: "x-scheme-handler/bibletext;", StartupWMClass: "BibleText"}
+	entry, makefile := render(scheme)
+	for _, want := range []string{"Exec=bibletext %u\n", "MimeType=x-scheme-handler/bibletext;\n"} {
+		if !strings.Contains(entry, want) {
+			t.Errorf("desktop entry lacks %q:\n%s", want, entry)
+		}
+	}
+	if !strings.Contains(makefile, `Exec := "bibletext"`) {
+		t.Errorf("the Makefile does not keep the bare binary name:\n%s", makefile)
+	}
+	if strings.Count(makefile, "\n\t-update-desktop-database ") != 2 {
+		t.Errorf("the Makefile must refresh mimeinfo.cache on both installs, tolerating a missing tool:\n%s", makefile)
+	}
+	if !strings.Contains(makefile, "|| echo \"update-desktop-database not found") {
+		t.Errorf("a missing update-desktop-database must be said out loud, not swallowed:\n%s", makefile)
+	}
+
+	// The icon is packaged as <AppID>.png but the Makefile's Icon variable holds
+	// the bare app id, so every line that uses it as a FILE NAME must add the
+	// extension. Without this, `make install` runs `install ... pixmaps/uk.co.bibletext`,
+	// which does not exist: the target installs the binary and the desktop entry
+	// and then exits non-zero, leaving the reader an application with no icon and
+	// an error they cannot interpret.
+	for _, want := range []string{
+		"usr/share/pixmaps/$(Icon).png $(DESTDIR)$(PREFIX)/share/pixmaps/$(Icon).png",
+		"-rm $(DESTDIR)$(PREFIX)/share/pixmaps/$(Icon).png",
+		"$(DESTDIR)$(HOME)/.local/share/icons/$(Icon).png",
+	} {
+		if !strings.Contains(makefile, want) {
+			t.Errorf("the Makefile does not install the icon by its real file name (%q):\n%s", want, makefile)
+		}
+	}
+	// ...and nowhere may it still treat the bare name as a file.
+	for _, bad := range []string{"pixmaps/$(Icon) ", "pixmaps/$(Icon)\n", "icons/$(Icon)\n"} {
+		if strings.Contains(makefile, bad) {
+			t.Errorf("the Makefile still uses the extensionless icon name as a file (%q):\n%s", bad, makefile)
+		}
+	}
+	// The .desktop entry is the opposite: freedesktop icon-theme lookup wants the
+	// name WITHOUT an extension, so the fix must not leak into it.
+	if strings.Contains(entry, "Icon=uk.co.bibletext.png") {
+		t.Errorf("the desktop entry's Icon= gained a file extension; theme lookup wants the bare name:\n%s", entry)
+	}
+
+	files := scheme
+	files.ExecField = " %F"
+	files.MimeTypes = "text/plain;"
+	entry, _ = render(files)
+	if !strings.Contains(entry, "Exec=bibletext %F\n") {
+		t.Errorf("a file opener lost its %%F:\n%s", entry)
+	}
+
+	params := scheme
+	params.ExecParams = "-x 42"
+	entry, _ = render(params)
+	if !strings.Contains(entry, "Exec=bibletext %u -x 42\n") {
+		t.Errorf("ExecParams are not appended after the field code:\n%s", entry)
+	}
+}
+
+// packageUNIX decides the field code from the MIME types: a scheme handler
+// takes %u even when it also opens files, anything else %F.
+func TestSchemeHandlerFieldCodeComesFromTheMimeTypes(t *testing.T) {
+	src := readPackageUnixSource(t)
+	for _, want := range []string{
+		`strings.Contains(mimes, "x-scheme-handler/")`,
+		`openWith = " %u"`,
+		`ExecField:      openWith,`,
+		`Exec:           filepath.Base(p.exe),`,
+	} {
+		if !strings.Contains(src, want) {
+			t.Errorf("package-unix.go lacks %q", want)
+		}
+	}
+	if strings.Contains(src, `Exec:           filepath.Base(p.exe) + openWith,`) {
+		t.Error("the field code is glued onto the binary name again, which breaks the Makefile")
+	}
+}
