+// BibleText patch: the canvas is the size of the app's window.
+//
+// Fyne sized its canvas from the screen (UIScreen.nativeBounds), so an iPad
+// window smaller than the screen — Split View, Stage Manager, the resizable
+// windows of iPadOS 26 — was laid out as if it filled the screen: a squashed
+// header, and a reading pane running off the window's edge. This reports the
+// view's own size, in the same pixels nativeBounds counts, so a window that
+// fills the screen reports exactly what it did before.
+//
+// A view that fills the screen reports nativeBounds itself, so every phone and
+// every full-screen iPad gets exactly the numbers it got before: bounds times
+// nativeScale can differ from nativeBounds by a pixel (the 12 and 13 mini,
+// Display Zoom), and nothing that already worked should move.
+//
+// updateConfig swaps width and height for a landscape orientation, so the pair
+// goes in portrait-first, as nativeBounds did. The orientation passed is the
+// window's shape: a tall window on a landscape iPad is laid out as portrait,
+// because the layout decides by the space it has.
+static void goAppReportSize(UIView *view) {
+	UIScreen *screen = [UIScreen mainScreen];
+	CGSize pt = view.bounds.size;
+	if (pt.width <= 0 || pt.height <= 0) {
+		pt = view.window != nil ? view.window.bounds.size : screen.bounds.size;
+	}
+	int w, h;
+	if (CGSizeEqualToSize(pt, screen.bounds.size)) {
+		// nativeBounds is portrait whatever the orientation; put it the view's way.
+		CGSize native = screen.nativeBounds.size;
+		BOOL viewWide = pt.width > pt.height;
+		w = (int)(viewWide ? MAX(native.width, native.height) : MIN(native.width, native.height));
+		h = (int)(viewWide ? MIN(native.width, native.height) : MAX(native.width, native.height));
+	} else {
+		w = (int)lround(pt.width * screen.nativeScale);
+		h = (int)lround(pt.height * screen.nativeScale);
+	}
+	BOOL wide = w > h;
+	UIInterfaceOrientation orientation = goAppInterfaceOrientation();
+	if (UIInterfaceOrientationIsLandscape(orientation) != wide) {
+		orientation = wide ? UIInterfaceOrientationLandscapeRight : UIInterfaceOrientationPortrait;
+	}
+	if (wide) {
+		int t = w;
+		w = h;
+		h = t;
+	}
+	updateConfig(w, h, orientation);
+}
