@@ -0,0 +1,10 @@
+//go:build (gles || arm || arm64) && !windows && !android && !ios && !mobile && !darwin && !wasm && !test_web_driver
+
+package gl
+
+import gl "github.com/go-gl/gl/v3.1/gles2"
+
+// BibleText patch: everywhere but Windows the binding's own loader stands,
+// which is what this file preserves while Windows takes its entry points
+// from GLFW (init_es_windows.go).
+func initGL() error { return gl.Init() }
