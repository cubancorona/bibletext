diff --git a/cmd/fyne/internal/util/mobile.go b/cmd/fyne/internal/util/mobile.go
index d438b9a..9515a57 100644
--- a/cmd/fyne/internal/util/mobile.go
+++ b/cmd/fyne/internal/util/mobile.go
@@ -13,0 +14,6 @@ func AndroidBuildToolsPath() string {
+	// BibleText pins the build-tools used by its Android wrapper. The upstream
+	// directory picker is not version-aware (for example, 9 sorts after 36), so
+	// an explicit path is the only deterministic selection.
+	if pinned := os.Getenv("BIBLETEXT_ANDROID_BUILD_TOOLS"); pinned != "" {
+		return pinned
+	}
diff --git b/cmd/fyne/internal/util/mobile_bibletext_test.go b/cmd/fyne/internal/util/mobile_bibletext_test.go
new file mode 100644
index 0000000..3736d75
--- /dev/null
+++ b/cmd/fyne/internal/util/mobile_bibletext_test.go
@@ -0,0 +1,37 @@
+package util
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestBibleTextAndroidBuildToolsPin(t *testing.T) {
+	sdkRoot := t.TempDir()
+	for _, version := range []string{"9.0.0", "35.0.0", "36.1.0"} {
+		if err := os.MkdirAll(filepath.Join(sdkRoot, "build-tools", version), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	t.Setenv("ANDROID_HOME", sdkRoot)
+	pinned := filepath.Join(sdkRoot, "build-tools", "36.1.0")
+	aapt2 := filepath.Join(pinned, "aapt2")
+	if err := os.WriteFile(aapt2, []byte("synthetic tool"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("BIBLETEXT_ANDROID_BUILD_TOOLS", pinned)
+
+	if got := AndroidBuildToolsPath(); got != pinned {
+		t.Fatalf("AndroidBuildToolsPath() = %q, want %q", got, pinned)
+	}
+
+	got, err := Aapt2Path()
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := aapt2
+	if got != want {
+		t.Fatalf("Aapt2Path() = %q, want %q", got, want)
+	}
+}
