diff --git b/cmd/fyne/internal/mobile/binres/sdk_bibletext_test.go b/cmd/fyne/internal/mobile/binres/sdk_bibletext_test.go
new file mode 100644
index 0000000..c171f53
--- /dev/null
+++ b/cmd/fyne/internal/mobile/binres/sdk_bibletext_test.go
@@ -0,0 +1,30 @@
+package binres
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestBibleTextAndroidPlatformPin(t *testing.T) {
+	sdkRoot := t.TempDir()
+	for _, version := range []string{"android-9", "android-35", "android-36"} {
+		if err := os.MkdirAll(filepath.Join(sdkRoot, "platforms", version), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	platform := filepath.Join(sdkRoot, "platforms", "android-36", "android.jar")
+	if err := os.WriteFile(platform, []byte("synthetic platform"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("ANDROID_HOME", sdkRoot)
+	t.Setenv("BIBLETEXT_ANDROID_PLATFORM", platform)
+
+	got, err := LatestAPIResourcesPath()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != platform {
+		t.Fatalf("LatestAPIResourcesPath() = %q, want %q", got, platform)
+	}
+}
