+++ b/cmd/fyne/internal/mobile/build_bibletext_test.go
@@ -0,0 +1,49 @@
+package mobile
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+)
+
+func TestBibleTextAndroidTargetSDK(t *testing.T) {
+	t.Parallel()
+	if androidTargetSDK != 36 {
+		t.Fatalf("androidTargetSDK = %d, want 36", androidTargetSDK)
+	}
+}
+
+func TestBibleTextAndroidNativeMinimum(t *testing.T) {
+	if flag := cmdBuild.Flag.Lookup("androidapi"); flag == nil || flag.DefValue != "24" {
+		t.Fatalf("native Android API flag default = %v, want 24", flag)
+	}
+	oldRelease := buildRelease
+	t.Cleanup(func() { buildRelease = oldRelease })
+	for _, release := range []bool{false, true} {
+		buildRelease = release
+		t.Run(map[bool]string{false: "debug", true: "release"}[release], func(t *testing.T) {
+			for _, arch := range []string{"arm", "arm64", "386", "amd64"} {
+				tc := ndk.Toolchain(arch)
+				root := t.TempDir()
+				bin := filepath.Join(root, "toolchains", "llvm", "prebuilt", archNDK(), "bin")
+				if err := os.MkdirAll(bin, 0o755); err != nil {
+					t.Fatal(err)
+				}
+				// A lower-API compiler exists, so an obsolete default chooses
+				// it and fails rather than advancing until it finds API 24.
+				for _, api := range []int{21, 24} {
+					file := filepath.Join(bin, tc.ClangPrefix(api)+"-clang")
+					if err := os.WriteFile(file, nil, 0o755); err != nil {
+						t.Fatal(err)
+					}
+				}
+				got := tc.Path(root, "clang")
+				want := filepath.Join(bin, tc.ClangPrefix(24)+"-clang")
+				if got != want {
+					t.Errorf("%s native compiler at default API %s = %q, want %q", arch, strconv.Itoa(buildAndroidAPI), got, want)
+				}
+			}
+		})
+	}
+}
