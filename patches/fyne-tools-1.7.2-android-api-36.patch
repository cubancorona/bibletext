@@ -0,0 +1,135 @@
+package mobile
+
+import (
+	"archive/zip"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+// The child process stands in for aapt2 while production resource compilation
+// constructs and executes its actual compile and link commands.
+func TestMain(m *testing.M) {
+	if os.Getenv("BIBLETEXT_TEST_RESOURCE_LINK_HELPER") == "1" {
+		if err := syntheticAapt2(os.Args[1:]); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(1)
+		}
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+func syntheticAapt2(args []string) error {
+	value := func(flag string) string {
+		for i, arg := range args {
+			if arg == flag && i+1 < len(args) {
+				return args[i+1]
+			}
+		}
+		return ""
+	}
+	if len(args) == 0 {
+		return fmt.Errorf("no aapt2 operation")
+	}
+	switch args[0] {
+	case "compile":
+		return os.WriteFile(filepath.Join(value("-o"), filepath.Base(args[len(args)-1])+".flat"), nil, 0o644)
+	case "link":
+		captured, err := json.Marshal(args)
+		if err != nil {
+			return err
+		}
+		if err := os.WriteFile(os.Getenv("BIBLETEXT_TEST_RESOURCE_LINK_ARGS"), captured, 0o644); err != nil {
+			return err
+		}
+		manifest, err := os.ReadFile(value("--manifest"))
+		if err != nil {
+			return err
+		}
+		output, err := os.Create(value("-o"))
+		if err != nil {
+			return err
+		}
+		archive := zip.NewWriter(output)
+		for name, data := range map[string][]byte{"resources.arsc": []byte("synthetic resources"), "AndroidManifest.xml": manifest} {
+			writer, err := archive.Create(name)
+			if err != nil {
+				return err
+			}
+			if _, err := writer.Write(data); err != nil {
+				return err
+			}
+		}
+		if err := archive.Close(); err != nil {
+			return err
+		}
+		return output.Close()
+	default:
+		return fmt.Errorf("unexpected aapt2 operation %q", args[0])
+	}
+}
+
+func TestBibleTextAndroidResourceLinkMinimum(t *testing.T) {
+	root := t.TempDir()
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	binary, err := os.ReadFile(self)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tool := "aapt2"
+	if runtime.GOOS == "windows" {
+		tool += ".exe"
+	}
+	if err := os.WriteFile(filepath.Join(root, tool), binary, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	platform := filepath.Join(root, "android.jar")
+	icon := filepath.Join(root, "foreground.png")
+	for _, file := range []string{platform, icon} {
+		if err := os.WriteFile(file, []byte("synthetic input"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("BIBLETEXT_ANDROID_BUILD_TOOLS", root)
+	t.Setenv("BIBLETEXT_ANDROID_PLATFORM", platform)
+	t.Setenv("BIBLETEXT_TEST_RESOURCE_LINK_HELPER", "1")
+	oldRelease := buildRelease
+	t.Cleanup(func() { buildRelease = oldRelease })
+	for _, release := range []bool{false, true} {
+		buildRelease = release
+		t.Run(map[bool]string{false: "debug", true: "release"}[release], func(t *testing.T) {
+			capture := filepath.Join(t.TempDir(), "link-args.json")
+			t.Setenv("BIBLETEXT_TEST_RESOURCE_LINK_ARGS", capture)
+			_, _, _, err := compileAndroidResources(t.TempDir(), []byte(`<manifest package="org.example.synthetic"><application/></manifest>`), icon, "", "", androidTargetSDK, 1, "1.0.0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			data, err := os.ReadFile(capture)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var args []string
+			if err := json.Unmarshal(data, &args); err != nil {
+				t.Fatal(err)
+			}
+			for flag, want := range map[string]string{"--min-sdk-version": "24", "--target-sdk-version": "36"} {
+				got, count := "", 0
+				for i, arg := range args {
+					if arg == flag && i+1 < len(args) {
+						got, count = args[i+1], count+1
+					}
+				}
+				if count != 1 || got != want {
+					t.Errorf("aapt2 link %s = %q (%d occurrences), want %q once", flag, got, count, want)
+				}
+			}
+		})
+	}
+}
