+package binres
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestBibleTextAndroidPlatformPin(t *testing.T) {
+	sdkRoot := t.TempDir()
+	for _, version := range []string{"android-9", "android-35", "android-36"} {
+		if err := os.MkdirAll(filepath.Join(sdkRoot, "platforms", version), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	platform := filepath.Join(sdkRoot, "platforms", "android-36", "android.jar")
+	if err := os.WriteFile(platform, []byte("synthetic platform"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("ANDROID_HOME", sdkRoot)
+	t.Setenv("BIBLETEXT_ANDROID_PLATFORM", platform)
+
+	got, err := LatestAPIResourcesPath()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got != platform {
+		t.Fatalf("LatestAPIResourcesPath() = %q, want %q", got, platform)
+	}
+}
+
+func TestBibleTextAndroidManifestMinimum(t *testing.T) {
+	old := skipSynthesize
+	skipSynthesize = false
+	t.Cleanup(func() { skipSynthesize = old })
+	manifest := `<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.example.synthetic"><application/></manifest>`
+	parsed, err := UnmarshalXML(strings.NewReader(manifest), false, 36)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := parsed.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded := new(XML)
+	if err := decoded.UnmarshalBinary(data); err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for element := range decoded.iterElements() {
+		if element.Name.Resolve(decoded.Pool) != "uses-sdk" {
+			continue
+		}
+		for _, attr := range element.attrs {
+			if attr.Name.Resolve(decoded.Pool) == "minSdkVersion" {
+				found = true
+				if attr.TypedValue.Type != DataIntDec || attr.TypedValue.Value != 24 {
+					t.Errorf("binary manifest minSdkVersion = %+v, want integer 24", attr.TypedValue)
+				}
+			}
+		}
+	}
+	if !found {
+		t.Fatal("binary manifest has no minimum SDK declaration")
+	}
+}
