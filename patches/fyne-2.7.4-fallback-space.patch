+// BibleText patch: go-text's face split never changes face for a space, so a
+// space after an emoji or a fallback-font character is shaped in that face.
+// There it can have no advance (the emoji face's space glyph has no bitmap,
+// and the shaper gives a glyph it cannot measure no advance), no glyph (drawn
+// as a missing-glyph box), a visible placeholder glyph, or a width unlike the
+// text's. A space separator alone in its cluster, shaped in a face other than
+// the one the font map gives it, is measured in that face, shaped alone; ok is
+// false for every other glyph. A space that shares its cluster with a
+// combining mark after it is left as shaped, so the mark is drawn on it.
+func spaceAdvance(shaper shaping.Shaper, faces shaping.Fontmap, in shaping.Input, g shaping.Glyph, alone *aloneGlyphs) (advance fixed.Int26_6, ok bool) {
+	if g.ClusterIndex < 0 || g.ClusterIndex >= len(in.Text) || g.RuneCount != 1 || g.GlyphCount != 1 {
+		return 0, false
+	}
+	r := in.Text[g.ClusterIndex]
+	if r == '\u1680' || !unicode.Is(unicode.Zs, r) { // U+1680 has a visible glyph
+		return 0, false
+	}
+	face := faces.ResolveFace(r)
+	if face == nil || face == in.Face {
+		return 0, false
+	}
+	ref, ok := alone.shape(shaper, in, face, r)
+	if !ok || ref.GlyphID == 0 || ref.Advance <= 0 {
+		return 0, false
+	}
+	return ref.Advance, true
+}
+
+// BibleText patch: DrawString draws a missing glyph as U+FFFD in the face the
+// font map gives that character, so the advance is that glyph's, shaped
+// alone. The missing glyph's own advance is kept only when that fails.
+func missingAdvance(shaper shaping.Shaper, faces shaping.Fontmap, in shaping.Input, g shaping.Glyph, alone *aloneGlyphs) fixed.Int26_6 {
+	face := faces.ResolveFace(0xfffd)
+	if face == nil {
+		return g.Advance
+	}
+	ref, ok := alone.shape(shaper, in, face, 0xfffd)
+	if !ok || ref.Advance <= 0 {
+		return g.Advance
+	}
+	return ref.Advance
+}
+
+// BibleText patch: a character shaped alone, with the size, script, language
+// and direction of the run it is in.
+type aloneKey struct {
+	face   *font.Face
+	r      rune
+	script language.Script
+	lang   language.Language
+	dir    di.Direction
+}
+
+type aloneGlyph struct {
+	glyph shaping.Glyph
+	ok    bool
+}
+
+// aloneGlyphs keeps what one string's spaces and missing glyphs are shaped
+// alone to, so each character is shaped once in a string however often it
+// appears. All of a string's runs share one size. BibleText patch.
+type aloneGlyphs map[aloneKey]aloneGlyph
+
+func (a *aloneGlyphs) shape(shaper shaping.Shaper, in shaping.Input, face *font.Face, r rune) (shaping.Glyph, bool) {
+	key := aloneKey{face: face, r: r, script: in.Script, lang: in.Language, dir: in.Direction}
+	if got, ok := (*a)[key]; ok {
+		return got.glyph, got.ok
+	}
+	ref := in
+	ref.Text = []rune{r}
+	ref.RunStart, ref.RunEnd = 0, 1
+	ref.Face = face
+	out := shaper.Shape(ref)
+	var got aloneGlyph
+	if len(out.Glyphs) == 1 {
+		got = aloneGlyph{glyph: out.Glyphs[0], ok: true}
+	}
+	if *a == nil {
+		*a = make(aloneGlyphs)
+	}
+	(*a)[key] = got
+	return got.glyph, got.ok
+}
+
+// FixDrawnAdvances gives each glyph in out the advance the painter gives it
+// when it draws: a space spaceAdvance measures again takes that advance, and
+// a missing glyph the advance of the U+FFFD drawn for it. It is for a caller
+// that lays out shaped runs itself. BibleText patch.
+func FixDrawnAdvances(shaper shaping.Shaper, faces shaping.Fontmap, in shaping.Input, out *shaping.Output) {
+	var alone aloneGlyphs
+	changed := false
+	for i, g := range out.Glyphs {
+		advance, ok := spaceAdvance(shaper, faces, in, g, &alone)
+		if !ok && g.GlyphID == 0 {
+			advance, ok = missingAdvance(shaper, faces, in, g, &alone), true
+		}
+		if ok && advance != g.Advance {
+			out.Glyphs[i].XAdvance = advance
+			out.Glyphs[i].Advance = advance
+			changed = true
+		}
+	}
+	if changed {
+		out.RecalculateAll()
+	}
+}
