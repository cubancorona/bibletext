@@ -0,0 +1,25 @@
+package mobile
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+// The generated Xcode project must declare the deployment target BibleText
+// ships for. Xcode 27 refuses a project whose IPHONEOS_DEPLOYMENT_TARGET is
+// below 15.0, and upstream's template says 9.0.
+func TestBibleTextIOSDeploymentTarget(t *testing.T) {
+	var out bytes.Buffer
+	if err := projPbxprojTmpl.Execute(&out, projPbxprojTmplData{
+		BitcodeEnabled: false, Debug: false, BundleID: "test.bundle", Profile: "", TeamID: "TEAM",
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(out.String(), "IPHONEOS_DEPLOYMENT_TARGET = 15.0;") {
+		t.Fatal("the Xcode project template does not declare IPHONEOS_DEPLOYMENT_TARGET = 15.0")
+	}
+	if strings.Contains(out.String(), "IPHONEOS_DEPLOYMENT_TARGET = 9.0;") {
+		t.Fatal("the Xcode project template still declares upstream's 9.0 deployment target")
+	}
+}
