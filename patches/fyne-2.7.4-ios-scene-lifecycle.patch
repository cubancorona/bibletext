+// BibleText patch: UIScene life cycle.
+//
+// An app linked against the iOS 27 SDK is refused at launch on iOS 27 unless it
+// adopts the scene life cycle ("UIScene life cycle is required for apps built
+// with this SDK"), and the app-delegate-only start below was all Fyne had. The
+// window now comes from a UIWindowScene when the bundle declares a scene
+// manifest (UIApplicationSceneManifest), and from the screen as before when it
+// does not, so a bundle without the manifest still starts the old way.
+//
+// The app delegate stays the owner of the window and the controller in both
+// paths, so everything that reaches for them — the keyboard, the file pickers,
+// isDark, the insets — works unchanged.
+API_AVAILABLE(ios(13.0))
+@interface GoAppSceneDelegate : UIResponder<UIWindowSceneDelegate>
+@property (strong, nonatomic) UIWindow *window;
+@end
+
+static BOOL goAppUsesScenes(void) {
+	if (@available(iOS 13.0, *)) {
+		return [[NSBundle mainBundle] objectForInfoDictionaryKey:@"UIApplicationSceneManifest"] != nil;
+	}
+	return NO;
+}
+
+// The interface orientation of the app's window. statusBarOrientation belongs
+// to the pre-scene life cycle; under scenes the window scene is the source.
+static UIInterfaceOrientation goAppInterfaceOrientation(void) {
+	if (@available(iOS 13.0, *)) {
+		GoAppAppDelegate *appDelegate = (GoAppAppDelegate *)[[UIApplication sharedApplication] delegate];
+		UIWindowScene *scene = appDelegate.window.windowScene;
+		if (scene != nil) {
+			return scene.interfaceOrientation;
+		}
+	}
+	return [[UIApplication sharedApplication] statusBarOrientation];
+}
