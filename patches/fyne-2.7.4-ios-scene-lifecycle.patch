+// Under scenes UIKit delivers incoming links to the scene delegate and never
+// calls the app delegate's link methods, which is where an app (through a
+// category on GoAppAppDelegate) implements them. These pass each link on, so
+// such an app needs no change.
+//
+// The app delegate's answer used to go back to iOS, and NO meant the app had
+// not handled the link. A scene callback has no answer to give, so a web link
+// the app declines is handed back to the system here, on the assumption that
+// opening an app's own universal link from inside that app goes to the browser
+// rather than back to the app.
+//
+// The hand-back waits until the scene is active: a link that launched the app
+// arrives while the scene is still connecting. The same URL is not handed back
+// twice within a few seconds, so the assumption failing cannot become a loop.
+static NSURL *goAppPendingHandBack;
+static NSURL *goAppLastHandBack;
+static CFAbsoluteTime goAppLastHandBackAt;
+
+static void goAppHandBack(NSURL *url) {
+	CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+	if (goAppLastHandBack != nil && [goAppLastHandBack isEqual:url] && now - goAppLastHandBackAt < 10) {
+		return;
+	}
+	[goAppLastHandBack release];
+	goAppLastHandBack = [url retain];
+	goAppLastHandBackAt = now;
+	[[UIApplication sharedApplication] openURL:url options:@{} completionHandler:nil];
+}
+
+static void goAppHandBackWhenActive(NSURL *url) {
+	if ([UIApplication sharedApplication].applicationState == UIApplicationStateActive) {
+		dispatch_async(dispatch_get_main_queue(), ^{
+			goAppHandBack(url);
+		});
+		return;
+	}
+	[goAppPendingHandBack release];
+	goAppPendingHandBack = [url retain];
+}
+
+API_AVAILABLE(ios(13.0))
+static void goAppForwardUserActivity(NSUserActivity *activity) {
+	UIApplication *application = [UIApplication sharedApplication];
+	id<UIApplicationDelegate> appDelegate = application.delegate;
+	if (![appDelegate respondsToSelector:@selector(application:continueUserActivity:restorationHandler:)]) {
+		return;
+	}
+	BOOL handled = [appDelegate application:application
+	                   continueUserActivity:activity
+	                     restorationHandler:^(NSArray<id<UIUserActivityRestoring>> *objects) {}];
+	if (!handled && [activity.activityType isEqualToString:NSUserActivityTypeBrowsingWeb]
+	    && activity.webpageURL != nil) {
+		goAppHandBackWhenActive(activity.webpageURL);
+	}
+}
+
+API_AVAILABLE(ios(13.0))
+static void goAppForwardURLContexts(NSSet<UIOpenURLContext *> *contexts) {
+	UIApplication *application = [UIApplication sharedApplication];
+	id<UIApplicationDelegate> appDelegate = application.delegate;
+	if (![appDelegate respondsToSelector:@selector(application:openURL:options:)]) {
+		return;
+	}
+	for (UIOpenURLContext *context in contexts) {
+		[appDelegate application:application openURL:context.URL options:@{}];
+	}
+}
+
+@implementation GoAppSceneDelegate
+// The app has one controller, so only the scene that holds it may drive it:
+// a callback from any other scene must not move it, blank it or change the
+// app's lifecycle stage.
+- (BOOL)ownsAppWindow {
+	GoAppAppDelegate *appDelegate = (GoAppAppDelegate *)[[UIApplication sharedApplication] delegate];
+	return self.window != nil && self.window == appDelegate.window;
+}
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions {
+	if (![scene isKindOfClass:[UIWindowScene class]]
+	    || ![session.role isEqualToString:UIWindowSceneSessionRoleApplication]) {
+		return;
+	}
+	GoAppAppDelegate *appDelegate = (GoAppAppDelegate *)[[UIApplication sharedApplication] delegate];
+	self.window = [[[UIWindow alloc] initWithWindowScene:(UIWindowScene *)scene] autorelease];
+	[appDelegate attachToWindow:self.window];
+
+	// A link that launched the app arrives with the connection, not through
+	// the continue/open callbacks below.
+	for (NSUserActivity *activity in connectionOptions.userActivities) {
+		goAppForwardUserActivity(activity);
+	}
+	if (connectionOptions.URLContexts.count > 0) {
+		goAppForwardURLContexts(connectionOptions.URLContexts);
+	}
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene {
+	if (![self ownsAppWindow]) {
+		return;
+	}
+	// Release the controller from this window so a reconnect can adopt it.
+	self.window.rootViewController = nil;
+	lifecycleAlive();
+}
+
+- (void)sceneDidBecomeActive:(UIScene *)scene {
+	if (![self ownsAppWindow]) {
+		return;
+	}
+	lifecycleFocused();
+	if (goAppPendingHandBack != nil) {
+		NSURL *url = goAppPendingHandBack;
+		goAppPendingHandBack = nil;
+		dispatch_async(dispatch_get_main_queue(), ^{
+			goAppHandBack(url);
+			[url release];
+		});
+	}
+}
+
+- (void)sceneWillResignActive:(UIScene *)scene {
+	if ([self ownsAppWindow]) {
+		lifecycleVisible();
+	}
+}
+
+- (void)sceneDidEnterBackground:(UIScene *)scene {
+	if ([self ownsAppWindow]) {
+		lifecycleAlive();
+	}
 }
+
+- (void)scene:(UIScene *)scene continueUserActivity:(NSUserActivity *)userActivity {
+	goAppForwardUserActivity(userActivity);
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts {
+	goAppForwardURLContexts(URLContexts);
+}
 @end
 
