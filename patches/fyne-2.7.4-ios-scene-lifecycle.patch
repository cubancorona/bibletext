+// Puts the one controller (and with it the GL context) into a window. A scene
+// the system disconnects and later reconnects gets a new window, but the same
+// controller, so the renderer's state survives the move.
+- (void)attachToWindow:(UIWindow *)window {
+	self.window = window;
+	if (self.controller == nil) {
+		self.controller = [[GoAppAppController alloc] initWithNibName:nil bundle:nil];
+	}
+	window.rootViewController = self.controller;
+	[window makeKeyAndVisible];
+
+	// update insets once key window is set
+	CGSize size = [UIScreen mainScreen].nativeBounds.size;
+	updateConfig((int)size.width, (int)size.height, goAppInterfaceOrientation());
+}
