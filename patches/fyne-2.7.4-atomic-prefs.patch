+// atomicWriter stages a preferences save in a temp file and publishes it with a
+// rename on Close. It satisfies writeSyncCloser, so saveToStorage's
+// encode -> Sync -> Close sequence needs no change: Sync makes the bytes
+// durable, Close makes them visible.
+type atomicWriter struct {
+	file *os.File
+	tmp  string
+	path string
+
+	failed bool // a Write or Sync error: never publish a partial blob
+	closed bool // Close is idempotent — saveToStorage defers it, callers may repeat it
+	synced bool // durable since the last Write, so Close need not fsync again
+}
