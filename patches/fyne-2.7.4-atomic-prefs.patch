+
+// Close publishes the blob, so unlike an ordinary Close its error means THE
+// SAVE DID NOT HAPPEN. saveToStorage used to discard that error with a bare
+// `defer writer.Close()`; the companion hunk in preferences.go promotes it to
+// the returned error, and the log line here is the backstop for anyone else.
+//
+// Every failure path removes the temp file and leaves the existing
+// preferences.json exactly as it was. A lost save is recoverable — the next
+// change writes again — where a published truncated blob is not.
+func (w *atomicWriter) Close() error {
+	if w.closed {
+		return nil
+	}
+	w.closed = true
+
+	var err error
+	if !w.synced { // an fsync here is a device barrier; don't pay for it twice
+		err = w.file.Sync()
+	}
+	if cerr := w.file.Close(); err == nil {
+		err = cerr
+	}
+	if w.failed && err == nil {
+		err = errPartialWrite
+	}
+	if err == nil {
+		err = os.Rename(w.tmp, w.path)
+	}
+	if err != nil {
+		os.Remove(w.tmp)
+		fyne.LogError("Preferences save not published; stored file left unchanged", err)
+		return err
+	}
+	return nil
+}
