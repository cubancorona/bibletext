+// sweepStale runs the temp-file sweep once per process. A ReadDir on every save
+// would be a directory scan on every chapter turn, which is exactly the kind of
+// cost this file is trying not to add.
+var sweepStale sync.Once
+
+// sweepStaleTemps removes temp files left behind by a process that was killed
+// between CreateTemp and the rename. Each is a whole copy of the store, so on a
+// device that jetsams the app regularly they would accumulate quietly inside the
+// sandbox forever.
+//
