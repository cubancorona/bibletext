 )
+
+// touchFontScope runs with fontScopeMutex held. Unscoped and explicit-font
+// entries keep their existing lifetimes; only temporary theme scopes use LRU.
+func touchFontScope(key cacheID) {
+	if entry := fontScopeEntries[key]; entry != nil {
+		fontScopeOrder.MoveToBack(entry)
+		return
+	}
+	fontScopeEntries[key] = fontScopeOrder.PushBack(key)
+	if fontScopeOrder.Len() > fontScopeCacheLimit {
+		oldest := fontScopeOrder.Front()
+		expired := oldest.Value.(cacheID)
+		fontCache.Delete(expired)
+		delete(fontScopeEntries, expired)
+		fontScopeOrder.Remove(oldest)
+	}
+}
 
