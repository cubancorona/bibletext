<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package manifest for BibleText on Windows.

  This is a template: `go run ./cmd/msstore manifest -out …` fills the four
  placeholders (the double-underscored upper-case tokens) from msstore/identity.json (what Partner Center assigned
  when the name was reserved) and cmd/desktop/FyneApp.toml (the version), and
  refuses to leave any behind. The Store re-signs the package, so the
  Publisher must be the CN=… value Partner Center shows, never a certificate
  of ours.

  Why these choices (docs/WINDOWS_STORE_LISTING.md, "Packaging"):
  - Windows.Desktop from 10.0.19041.0: the uap10 RuntimeBehavior/TrustLevel
    form of a packaged classic app needs that floor; older systems would
    refuse the install rather than run it. MaxVersionTested is the newest
    Windows 11 the app was exercised on.
  - runFullTrust is the only capability: a full-trust Win32 process already
    runs as the user, so internetClient and the other AppContainer
    capabilities do not apply to it.
  - The tiles are the qualifier-named files under Assets/, generated from
    icon/full.png by the same command; makepri turns the qualifiers into
    resources.pri on the runner.
  - Two link handlers under Extensions: the web-to-app handler for
    bibletext.co.uk (shell-launched https links) and the bibletext: scheme
    (browser clicks, via the site's button). Both hand the URL to the exe on
    its command line. cmd/msstore's tests pin them.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop2 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__IDENTITY_PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>BibleText</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-GB" />
  </Resources>

  <Applications>
    <Application
      Id="BibleText"
      Executable="BibleText.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="BibleText"
        Description="A quiet, fast Bible reader. Search, study, and read with no ads and no tracking."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!--
          Web-to-app linking (Settings > Apps > Apps for websites): a
          https://bibletext.co.uk/... link launched THROUGH THE SHELL (Outlook,
          Teams, the Run box, Explorer - anything that calls ShellExecuteEx)
          opens the app. Links clicked in Edge, Chrome or Firefox stay in the
          browser by Microsoft's design. The site consents in
          /.well-known/windows-app-web-link (docs/windows-app-web-link), which
          Windows fetches itself; the Store checks nothing. desktop2:Parameters
          puts the URL on BibleText.exe's command line (share_link_argv.go).
          www is not listed: it redirects to the apex and serves nothing.
        -->
        <uap3:Extension Category="windows.appUriHandler">
          <uap3:AppUriHandler desktop2:Parameters="%1">
            <uap3:Host Name="bibletext.co.uk" />
          </uap3:AppUriHandler>
        </uap3:Extension>
        <!--
          The bibletext: scheme - the only route from a browser click on any
          desktop, and what the site's "Open in BibleText" button uses. The
          payload is the https link with the scheme swapped; the app swaps it
          back before ParseShareLink. Full-trust apps take the URI as a
          command-line parameter; the quoted %1 is Microsoft's own example.
        -->
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="bibletext" Parameters="&quot;%1&quot;">
            <uap:DisplayName>BibleText link</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
