{
  // Build / run / test tasks for the BibleText Fyne app.
  //   Cmd+Shift+B          -> "Build (compile check)"   (default build)
  //   Cmd+Shift+P > Run Test Task -> "Test (race)"      (default test)
  //   Cmd+Shift+P > Run Task -> any of the below
  // The shared package lives at the repo root; entry points are in cmd/.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (compile check)",
      "detail": "go build ./... — fast 'does everything compile' check",
      "type": "shell",
      "command": "go build ./...",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run Desktop (go run)",
      "detail": "Fast build + launch of the desktop reader (no .app bundle)",
      "type": "shell",
      "command": "go run ./cmd/desktop",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run Desktop (dev build)",
      "detail": "go run with the bibletextdev tag — Links tab, dev scenarios, mimic switch available",
      "type": "shell",
      "command": "go run -tags bibletextdev ./cmd/desktop",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run Desktop MIMIC (Linux)",
      "detail": "The Mac wears the Linux build: styled pane, Fyne note banner, no TTS, DejaVu→Gelasio fonts. Header shows the MIMIC badge. docs/PLATFORM_MIMIC.md says what this proves.",
      "type": "shell",
      "command": "BIBLETEXT_MIMIC=linux go run -tags bibletextdev ./cmd/desktop",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run Desktop MIMIC (Windows)",
      "detail": "The Mac wears the Windows build: styled pane, Fyne note banner, no TTS, Georgia stays. Header shows the MIMIC badge.",
      "type": "shell",
      "command": "BIBLETEXT_MIMIC=windows go run -tags bibletextdev ./cmd/desktop",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Package Desktop (.app)",
      "detail": "fyne package -> cmd/desktop/BibleText.app",
      "type": "shell",
      "command": "PATH=\"$(go env GOPATH)/bin:$PATH\" fyne package -os darwin --app-id uk.co.bibletext.desktop",
      "options": { "cwd": "${workspaceFolder}/cmd/desktop" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Package iOS Simulator",
      "detail": "fyne package -> cmd/mobile (iossimulator)",
      "type": "shell",
      "command": "PATH=\"$(go env GOPATH)/bin:$PATH\" fyne package -os iossimulator --app-id uk.co.bibletext",
      "options": { "cwd": "${workspaceFolder}/cmd/mobile" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run on iOS Simulator",
      "detail": "package + boot sim + install + launch (scripts/run-ios-sim.sh)",
      "type": "shell",
      "command": "./scripts/run-ios-sim.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run on iOS Simulator (dev)",
      "detail": "run-ios-sim.sh --dev — the Links tab + dev scenarios build",
      "type": "shell",
      "command": "./scripts/run-ios-sim.sh --dev",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Build Android APK (debug)",
      "detail": "scripts/build-android.sh -> cmd/mobile/BibleText.apk (with the BtBridge/BtAudio dex; NOT bare fyne package)",
      "type": "shell",
      "command": "./scripts/build-android.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Run on Android Emulator",
      "detail": "build + boot the bibletext_test AVD (API 35 arm64) if needed + install + launch",
      "type": "shell",
      "command": "source \"$HOME/Library/Android/env.sh\" && if ! adb devices | grep -qE 'emulator-[0-9]+[[:space:]]+device'; then (emulator -avd bibletext_test >/dev/null 2>&1 &) fi && adb wait-for-device && until [ \"$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\\r')\" = \"1\" ]; do sleep 2; done && adb install -r cmd/mobile/BibleText.apk && adb shell am start -n uk.co.bibletext/org.golang.app.GoNativeActivity",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Build Android APK (debug)"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android Logcat (BibleText)",
      "detail": "app log stream — Go's log.Printf arrives under the GoLog tag",
      "type": "shell",
      "command": "source \"$HOME/Library/Android/env.sh\" && adb logcat -T 1 -s GoLog:V Fyne:V AndroidRuntime:E ActivityManager:W",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Test (race)",
      "detail": "go test -race ./...",
      "type": "shell",
      "command": "go test -race ./...",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test (verbose)",
      "type": "shell",
      "command": "go test -v ./...",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Test Coverage",
      "detail": "writes coverage.out (open with: go tool cover -html=coverage.out)",
      "type": "shell",
      "command": "go test -coverprofile=coverage.out ./...",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Vet",
      "type": "shell",
      "command": "go vet ./... && go vet -tags bibletextdev ./...",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "View-test gate (mutations)",
      "detail": "scripts/view-test-gate.sh — 8 planted UI defects, every one must be caught",
      "type": "shell",
      "command": "./scripts/view-test-gate.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint (golangci-lint)",
      "detail": "optional — needs golangci-lint installed (flag-compatible with v1 and v2)",
      "type": "shell",
      "command": "golangci-lint run",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "Format (gofmt)",
      "type": "shell",
      "command": "gofmt -l -w .",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none"
    },
    {
      "label": "Tidy (go mod tidy)",
      "type": "shell",
      "command": "go mod tidy",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none"
    }
  ]
}
