{
  // Run/Debug for the BibleText (Fyne) app.
  // The repo root is the `bibletext` LIBRARY package; the real entry points
  // live under cmd/.
  //
  //   "Debug ..."  -> runs under the delve debugger (breakpoints, stepping).
  //   "Run ..."    -> launches the app in an integrated terminal with NO
  //                   debugger attached (node-terminal just runs the shell
  //                   command; node isn't involved).
  //
  // Note: ⌃F5 (Run > Run Without Debugging) also runs any config below without
  // the debugger — the "Run ..." entries are just one-click shortcuts for it.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Desktop (no debugger)",
      "type": "node-terminal",
      "request": "launch",
      // `&& exit` closes the integrated terminal when the app exits cleanly (you
      // close the window), which ends the debug session so VS Code's Stop button
      // disappears on its own. A node-terminal session stays "running" as long as
      // its terminal is open, so WITHOUT this the app quits but the Stop button
      // lingers until you click it. On a COMPILE error `go run` exits non-zero, so
      // `&& exit` is skipped and the terminal stays open with the error visible.
      "command": "go run ./cmd/desktop && exit",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Desktop DEV build (no debugger)",
      // The bibletextdev tag: Links tab, dev scenarios, and the mimic switch.
      "type": "node-terminal",
      "request": "launch",
      "command": "go run -tags bibletextdev ./cmd/desktop && exit",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Desktop MIMIC: Linux (no debugger)",
      // The Mac wears the Linux build — styled pane, Fyne note banner, no TTS,
      // DejaVu→Gelasio fonts, MIMIC badge in the header. What this proves and
      // what still needs real hardware: docs/PLATFORM_MIMIC.md.
      "type": "node-terminal",
      "request": "launch",
      "command": "BIBLETEXT_MIMIC=linux go run -tags bibletextdev ./cmd/desktop && exit",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Desktop MIMIC: Windows (no debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "BIBLETEXT_MIMIC=windows go run -tags bibletextdev ./cmd/desktop && exit",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Packaged Desktop (.app, no debugger)",
      // Builds the macOS .app bundle, then runs its binary in the foreground
      // (so VS Code's Stop button controls it). Use this to exercise the real
      // shipped artifact (proper app-id, icon, bundle behaviour). Trailing
      // `&& exit` closes the terminal on a clean quit (see note above).
      "type": "node-terminal",
      "request": "launch",
      "command": "PATH=\"$(go env GOPATH)/bin:$PATH\" fyne package -os darwin --app-id uk.co.bibletext && './BibleText.app/Contents/MacOS/desktop' && exit",
      "cwd": "${workspaceFolder}/cmd/desktop"
    },
    {
      "name": "Run on iOS Simulator (no debugger)",
      // Packages the iOS-simulator .app, boots a simulator, installs and
      // launches it (scripts/run-ios-sim.sh). Requires Xcode, an iOS runtime,
      // and an "Apple Development" cert — see the script header.
      //
      // There is deliberately NO delve "Debug iOS" config: a Go app cross-
      // compiled into an iOS bundle and run inside the simulator sandbox is not
      // delve-debuggable via vscode-go. Debug iOS-specific code with log/print
      // + Console.app, or step the SAME Go logic via "Debug Desktop App".
      "type": "node-terminal",
      "request": "launch",
      "command": "./scripts/run-ios-sim.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Desktop App",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/desktop",
      "cwd": "${workspaceFolder}",
      "showLog": true,
      // To exercise AI study with a key while debugging, export a provider env var
      // in the SHELL you launch VS Code from (GEMINI_API_KEY / OPENAI_API_KEY /
      // ANTHROPIC_API_KEY / XAI_API_KEY — they override the on-device stored key).
      // Do NOT paste a real key into this committed file.
      "env": {}
    },
    {
      "name": "Debug Desktop MIMIC: Linux",
      // Delve over the LINUX code paths, on the Mac — the styled pane and the
      // whole Win/Linux surface are pure Go under mimic, so breakpoints and
      // stepping work in code you could previously only printf on a CI runner.
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/desktop",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags bibletextdev",
      "env": { "BIBLETEXT_MIMIC": "linux" }
    },
    {
      "name": "Debug Desktop MIMIC: Windows",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/desktop",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags bibletextdev",
      "env": { "BIBLETEXT_MIMIC": "windows" }
    },
    {
      "name": "Debug Package Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}",
      "args": ["-test.v"]
    },
    {
      "name": "Debug Test At Cursor",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}",
      // Select a test name in the editor, then run this config.
      "args": ["-test.v", "-test.run", "${selectedText}"]
    }
  ]
}
