# Compiled application binaries
/bibletext
/cmd/desktop/desktop
/cmd/mobile/mobile
# fyne's android packaging also drops the gomobile binary at the REPO ROOT,
# which the /cmd/mobile/mobile rule above does not cover — it was tracked by
# accident on 19 Aug and rode six commits at 37 MB a revision.
/mobile

# Fyne mobile packaging output (.app, .ipa, .apk, .aab and bundle dirs)
*.app
*.ipa
*.apk
*.aab

# Go test / build / coverage artifacts
*.test
*.out
coverage.*

# Local Bible caches (normally live in the OS cache dir; ignore any local copy —
# the app writes one bibletext-<version-id>.json per translation)
bibletext-cache.json
bibletext-*.json

# Claude Code local (per-machine) settings
.claude/settings.local.json

# macOS / editor cruft
.DS_Store
third_party/
icon_work/
build/
/desktop

# Android bridge build output (compiled by scripts/build-android.sh)
android/classes/
*.idsig
*.dm
*.dex

# Local AI provider keys for testing (never committed) — see ai_live_test.go
.env.local
build/

# Bundled API.Bible key, generated for one release build then deleted
# (scripts/embed-bible-key.sh) — a key must never be committed.
bundled_key_gen.go
