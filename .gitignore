# Compiled application binaries
/bibletext
/cmd/bibletext/bibletext
/cmd/mobile/mobile
# Fyne's Android packaging also drops the gomobile binary at the repository
# root, which the /cmd/mobile/mobile rule above does not cover.
/mobile

# Files the Fyne CLI writes into the checkout while it builds (`fyne install`,
# `fyne package`, `fyne build --pprof`); untracked, they would mark every such
# build +dirty in its version stamp.
fyne_metadata_init.go
fyne_pprof.go

# Fyne mobile packaging output (.app, .ipa, .apk, .aab and bundle dirs)
*.app
*.ipa
*.apk
*.aab

# Go test / build / coverage artifacts
*.test
*.out
coverage.*

# Local Bible caches (normally live in the OS cache dir; ignore any local copy —
# the app writes one bibletext-<version-id>.json per translation)
bibletext-cache.json
bibletext-*.json

# Local per-machine tool settings
.claude/

# macOS / editor cruft
.DS_Store
third_party/
icon_work/
build/

# Intermediate executables the packagers build inside cmd/bibletext before
# `fyne package` folds them into a bundle. They are untracked, and the hygiene
# check scans untracked-but-unignored file CONTENTS for the bundled API key, so
# a half-finished local Store or Windows build would otherwise report a real
# key hit. One name per platform, because each channel names its executable the
# way that platform expects.
/cmd/bibletext/BibleText
/cmd/bibletext/BibleText.exe
/cmd/bibletext/BibleText.app/

# Android bridge build output (compiled by scripts/build-android.sh)
android/classes/
*.idsig
*.dm
*.dex

# Local AI provider keys for testing (never committed) — see ai_live_test.go
.env.local
build/
